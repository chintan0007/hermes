# --- SECURITY: NEVER COMMIT THE REAL .ENV TO GITHUB ---
# Copy this to a file named .env and fill in your real values

# Wallet Credentials (Use a burner wallet!)
PRIVATE_KEY=your_private_key_here
SAFE_ADDRESS=your_proxy_wallet_address_here

# Polymarket CLOB V2 Settings
CHAIN_ID=137
HOST=clob.polymarket.com

# Telegram Notifications
TELEGRAM_TOKEN=your_telegram_bot_token_here
CHAT_ID=your_telegram_chat_id_here

# Trading Parameters
DRY_RUN=true
MIN_EDGE=0.02
MIN_BET=1.0
MAX_BET=10.0
BANKROLL=10.0
